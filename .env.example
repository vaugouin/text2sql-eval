# API Key for authentication
TEXT2SQL_API_KEY=your_text2sql_api_key
TEXT2SQL_API_URL=http://your_domain
# API exposed port for Blue/Green deployment
API_PORT_BLUE=8000
API_PORT_GREEN=8001

# Provider keys, sent to the Text2SQL API with every question (X-OpenAI-Key, X-Anthropic-Key,
# X-Google-Key, X-OpenRouter-Key): the API holds no OpenAI key, and uses its own key for the other
# providers only when the request brings none. OPENAI_API_KEY is required for any campaign.
OPENAI_API_KEY=your_openai_api_key
#ANTHROPIC_API_KEY=your_anthropic_api_key
#GOOGLE_API_KEY=your_google_api_key
#OPENROUTER_API_KEY=your_openrouter_api_key

# Define variables
DB_HOST=your_database_host
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAMESPACE=T_WC_

USER_TIMEZONE=Europe/Paris

